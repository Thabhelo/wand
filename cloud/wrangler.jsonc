{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wand-relay",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.getwand.app",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICES",
        "class_name": "Device"
      },
      {
        "name": "LIMITS",
        "class_name": "RateLimit"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Device",
        "RateLimit"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wand-registry",
      "migrations_dir": "migrations",
      "database_id": "3d4aa9ec-bbf7-4d39-810b-43116d0b812e"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "wand-getwand",
    "FIREBASE_API_KEY": "AIzaSyCX5WZDFbL3Md2Rky39tbpspMiTg7XabxA",
    "FIREBASE_AUTH_DOMAIN": "wand-getwand.firebaseapp.com",
    "FIREBASE_APP_ID": "1:65004035287:web:6d1691580121e8301ce492",
    "MUSE_CLIENT_IDS": "",
    "FACEBOOK_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a4bd7fd307284c258c9b058f6eaa66d3"
    }
  ]
}
