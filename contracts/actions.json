  {
    "name": "close_browser_tabs",
    "description": "Close tabs in the named browser after explicit confirmation, preserving pinned tabs by default.",
    "risk": "medium",
    "approval": "always",
    "params": {
      "type": "object",
      "properties": {
        "browser": {
          "enum": [
            "safari",
            "chrome"
          ]
        },
        "keep_pinned": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "browser"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "quit_app",
    "description": "Ask the identified app to quit gracefully after explicit confirmation.",
    "risk": "high",
    "approval": "always",
    "params": {
      "type": "object",
      "properties": {
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "app_name"
          ]
        },
        {
          "required": [
            "bundle_id"
          ]
        }
      ]
    }
  },
  {
    "name": "open_app",
    "description": "Open the identified installed application.",
    "risk": "medium",
    "approval": "never",
    "params": {
      "type": "object",
      "properties": {
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "app_name"
          ]
        },
        {
          "required": [
            "bundle_id"
          ]
        }
      ]
    }
  },
  {
    "name": "open_url",
    "description": "Open an HTTP or HTTPS URL in the default browser.",
    "risk": "medium",
    "approval": "never",
    "params": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s/]+[^\\s]*(?![\\s\\S])",
          "maxLength": 2048
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
